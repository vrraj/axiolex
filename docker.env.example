# Docker Compose environment configuration for Axiolex
# Copy this file to .env.docker and edit as needed:
#   cp docker.env.example .env.docker
#   docker compose --env-file .env.docker up -d

# --- Axiolex ports (host-side) ---
AXIOLEX_API_PORT=9700
# AXIOLEX_MCP_PORT=9701

# --- Redis DB index ---
AXIOLEX_REDIS_DB=0

# --- Discovery defaults ---
# Default number of tools Axiolex returns when the caller does not specify top_k.
AXIOLEX_TOP_K=7

# --- Hybrid / ColBERT search ---
# Set to true to enable hybrid (BM25 + ColBERT) search by default.
# Requires the colbert extra, which IS included in the Docker image.
# First startup will download the ColBERT model (~436MB) into the
# axiolex-models volume.
AXIOLEX_HYBRID_ENABLED=true
# AXIOLEX_COLBERT_MODEL=colbert-ir/colbertv2.0
# AXIOLEX_COLBERT_BATCH_SIZE=32
# AXIOLEX_HYBRID_CANDIDATE_LIMIT=50
# AXIOLEX_RRF_K=60

# --- MCP provider API keys (optional) ---
# Set these if your mcp_providers.yaml references them via secret_env.
# These are passed through to the container at runtime — never baked into the image.
# ALPHAVANTAGE_API_KEY=
# TAVILY_API_KEY=

# --- Encrypted secret store (optional) ---
# Master key for encrypting MCP provider API keys.
# Generate with: openssl rand -hex 32
# AXIOLEX_SECRET_MASTER_KEY=
