# Axiolex environment configuration
# Copy this file to .env and edit as needed.

# --- Redis (required) ---
# Axiolex is a shared service backed by Redis. Point these at your Redis instance.
AXIOLEX_REDIS_HOST=localhost
AXIOLEX_REDIS_PORT=6380
AXIOLEX_REDIS_DB=0

# Redis tool-cache TTLs in seconds. Set to 0 to keep cached tools until
# explicit refresh, provider invalidation, or Redis eviction.
AXIOLEX_REDIS_DISCOVERY_TTL_SECONDS=0
AXIOLEX_REDIS_RUNTIME_TTL_SECONDS=0

# --- Hybrid / ColBERT search (optional) ---
# Enabled adds ColBERT semantic ranking on top of BM25 lexical search.
# Requires: pip install axiolex[colbert]
AXIOLEX_HYBRID_ENABLED=false
AXIOLEX_COLBERT_MODEL=colbert-ir/colbertv2.0
AXIOLEX_COLBERT_CACHE_DIR=~/.cache/axiolex/fastembed
AXIOLEX_COLBERT_BATCH_SIZE=32
AXIOLEX_HYBRID_CANDIDATE_LIMIT=50
AXIOLEX_RRF_K=60

# --- Encrypted secret store (optional) ---
# Master key for encrypting MCP provider API keys stored in source_files/mcp_secrets.enc.
# Generate with: openssl rand -hex 32
# AXIOLEX_SECRET_MASTER_KEY=

# --- MCP provider API keys (optional) ---
# Set these if your mcp_providers.yaml references them via secret_env.
# ALPHAVANTAGE_API_KEY=
# TAVILY_API_KEY=
