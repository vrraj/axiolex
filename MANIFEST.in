include README.md
include LICENSE
include Makefile
include pyproject.toml
include settings.yaml
include documents.yaml

recursive-include axiolex *.py
recursive-include axiolex/ui *.html *.js *.css
recursive-include docs *.md *.html
recursive-include source_files *.yaml
recursive-include examples *.py

global-exclude __pycache__ *.py[cod] .DS_Store
global-exclude .git* venv* test_env*
